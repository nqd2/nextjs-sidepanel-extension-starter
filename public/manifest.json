{
  "manifest_version": 3,
  "name": "Next.js Side Panel",
  "version": "0.1.0",
  "description": "Chrome side panel extension built with Next.js",
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
